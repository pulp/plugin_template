{% include 'header.j2' %}
{% from 'macros.j2' import
  setup_python,
  configure_git,
  install_python_deps,
with context %}

---
name: "{{ plugin_app_label | camel }} Update Labels"
on:
  push:
    branches:
      - "main"
    paths:
      - "template_config.yml"

env:
  UV_SYSTEM_PYTHON: "1"

jobs:
  update_backport_labels:
    runs-on: "ubuntu-latest"
    steps:
      {{ setup_python(pyversion="3.12") | indent(6) }}
      {{ configure_git() | indent(6) }}
      - uses: "actions/checkout@v6"
      - name: "Update labels"
        run: |
          uv run --script .github/workflows/scripts/update_backport_labels.py
        env:
          {%- raw %}
          GITHUB_TOKEN: "${{ secrets.RELEASE_TOKEN }}"
          {%- endraw %}
...
